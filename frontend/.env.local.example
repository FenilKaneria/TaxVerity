# Copy to .env.local (gitignored) and edit if needed.
#
# The backend's CORS allows exactly one origin, settings.app_base_url,
# which defaults to http://localhost:3000 — so run this dev server as
# `localhost:3000`, not `127.0.0.1:3000` (different origins, the second is
# rejected).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
