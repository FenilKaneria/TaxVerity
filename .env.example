# TaxVerity configuration.
#
# Copy to `.env` at the repository root and edit. `.env` is gitignored.
# Precedence: environment variable > .env > the default in config.py.
#
# Every variable is prefixed TAXVERITY_ — including the provider API keys,
# which convention would leave bare. DATA_DIR and DATABASE_URL are too generic
# to claim unprefixed, and one consistent rule beats a mixed scheme.
#
# Nothing here is required to run the current phase. Path settings have working
# defaults, and secrets are only read when the component that needs them calls
# Settings.require(), which raises naming the missing variable.


# --- Paths -------------------------------------------------------------------
# Defaults are relative to the repository root. Note that data/interim is
# derived from TAXVERITY_DATA_DIR rather than set separately, so overriding the
# data directory moves the interim directory with it.

# TAXVERITY_CORPUS_PDF=./Income-tax-Act-2025.pdf
# TAXVERITY_DATA_DIR=./data
# TAXVERITY_REPORTS_DIR=./reports
# TAXVERITY_EVALS_DIR=./evals


# --- Logging -----------------------------------------------------------------
# Level is any stdlib logging level name. Format is `text` (human-readable, the
# default) or `json` (one object per line, for log aggregation from Phase 17).
# PAN / Aadhaar / account numbers are masked by a filter on the handler, so
# redaction holds whatever a call site passes — it is not a call-site
# convention.

# TAXVERITY_LOG_LEVEL=INFO
# TAXVERITY_LOG_FORMAT=text

# --- Secrets -----------------------------------------------------------------
# Not read yet. Listed so the shape of a full configuration is visible, with
# the phase each becomes necessary.

# Jina — Phase 4 embeddings (ADR-075), and later the Step 5.6 reranker on the
# same key (ADR-052). Needed by scripts/embed_corpus.py and the query path.
# TAXVERITY_JINA_API_KEY=

# Postgres + pgvector — Phase 6. This URL matches the local container from
# `docker compose up -d` (compose.yaml); the credentials are dev-only and the
# port is published on loopback only. Use 127.0.0.1, not localhost: on Windows
# localhost may resolve to ::1 first, where nothing listens.
# TAXVERITY_DATABASE_URL=postgresql://taxverity:taxverity@127.0.0.1:5432/taxverity

# Access-token signing key — Step 11.3. At least 32 bytes of randomness, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Rotating it
# logs every user out after at most one access-token lifetime (15 minutes).
# TAXVERITY_JWT_SECRET=

# Which index to serve — Step 6.6. Both are checked against the database before
# the process serves anything, and against each other: an embedding set id is a
# serial, so a database reloaded from another corpus reuses the same integers.
# The corpus_version is the one in data/interim/chunk_manifest.json.
# TAXVERITY_SERVING_CORPUS_VERSION=
# TAXVERITY_SERVING_EMBEDDING_SET_ID=1

# LLM providers — Phase 7. Groq is primary, Gemini is the cross-vendor fallback.
# TAXVERITY_GROQ_API_KEY=
# TAXVERITY_GEMINI_API_KEY=

# Langfuse tracing — Phase 7.4. Self-hosted; set the host to your instance.
# TAXVERITY_LANGFUSE_PUBLIC_KEY=
# TAXVERITY_LANGFUSE_SECRET_KEY=
# TAXVERITY_LANGFUSE_HOST=http://localhost:3000
