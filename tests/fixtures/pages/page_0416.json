[264.95,118.78,267.77,128.18],"bold":true,"font":"LiberationSerif-Bold","furniture":false,"italic":false,"size":8.49,"text":"]"},{"bbox":[29.74,190.92,156.01,200.31],"bold":false,"font":"LiberationSerif","furniture":false,"italic":false,"size":8.49,"text":"69. Ins. by Act No. 4 of 2026, w.e.f. "},{"bbox":[156.08,190.92,187.63,200.31],"bold":true,"font":"LiberationSerif-Bold","furniture":false,"italic":false,"size":8.49,"text":"1-4-2026"},{"bbox":[187.7,190.92,189.82,200.31],"bold":false,"font":"LiberationSerif","furniture":false,"italic":false,"size":8.49,"text":"."},{"bbox":[27.62,62.75,34.76,70.58],"bold":false,"font":"LiberationSerif","furniture":false,"italic":false,"size":7.07,"text":"69"},{"bbox":[76.5,17.17,221.38,33.52],"bold":true,"font":"NotoSans-Bold","furniture":true,"italic":false,"size":12.0,"text":"Income Tax Department"},{"bbox":[76.5,33.13,249.06,45.39],"bold":false,"font":"NotoSans-Regular","furniture":true,"italic":false,"size":9.0,"text":"Ministry of Finance, Government of India"}],"text":"[Merger of registered non-profit organisation in certain cases.\n354A. Where any registered non-profit organisation merges with any other registered non-profit organisation, the provisions of section 352 shall not apply\nif, —\n(a) the other registered non-profit organisation has same or similar objects; and\n(b) the said merger fulfils such conditions as may be prescribed.]\n69. Ins. by Act No. 4 of 2026, w.e.f. 1-4-2026.\n69\nIncome Tax Department\nMinistry of Finance, Government of India\n"}